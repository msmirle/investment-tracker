// Prisma schema — SQLite for zero-config local persistence.
generator client {
  provider      = "prisma-client-js"
  // native = local dev (Windows/macOS/Linux glibc); linux-musl = Alpine in Docker.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Holding {
  id           String    @id @default(cuid())
  symbol       String
  name         String?
  assetType    String    // STOCK | ETF | CRYPTO
  quantity     Float
  costBasis    Float
  currency     String    @default("USD")
  purchaseDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Transaction {
  id         String   @id @default(cuid())
  symbol     String
  name       String?
  assetType  String   // STOCK | ETF | CRYPTO
  action     String   // BUY | SELL
  quantity   Float
  price      Float    // price per unit at execution (in `currency`)
  fees       Float    @default(0)
  currency   String   @default("USD")
  account    String?
  firm       String?  // e.g. Investia, Questrade
  accountNumber String? // e.g. 317382565
  orderType  String?  // MARKET | LIMIT | ...
  executedAt DateTime
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([symbol, executedAt])
}

// Per-symbol overrides for quote sourcing.
// - quoteSymbol: optional alias used when fetching live prices (e.g. Yahoo
//   Morningstar Performance ID "0P000074ST.TO" for a fund whose FundServ
//   code isn't indexed).
// - manualPrice: optional last-known NAV to use when no upstream quote
//   exists at all. Takes precedence over quoteSymbol when set.
model SymbolMeta {
  symbol              String   @id
  quoteSymbol         String?
  manualPrice         Float?
  manualPriceCurrency String?
  manualPriceAsOf     DateTime?
  notes               String?
  updatedAt           DateTime @updatedAt
}
