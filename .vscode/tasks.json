{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "next: dev",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "next",
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:\\s+http"
        }
      }
    },
    {
      "label": "next: dev (terminate)",
      "type": "process",
      "command": "${input:terminateNextDev}"
    }
  ],
  "inputs": [
    {
      "id": "terminateNextDev",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "next: dev"
    }
  ]
}
